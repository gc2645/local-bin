#   llamactl serve unsloth/gpt-oss-120b-GGUF:Q4_K_M
#   llamactl run unsloth/gpt-oss-120b-GGUF:Q4_K_M
#   llamactl run unsloth/GLM-4.7-Flash-GGUF:UD-Q4_K_XL --temp 1.0 --top-p 0.95
# =====================================================================


def add_list_args(p):
    p.add_argument(
        "min_gb",
        nargs="?",
        type=float,
        default=DEFAULT_MIN_GB,
        help=f"minimum GGUF file size in GB, default {DEFAULT_MIN_GB}",
    )
    p.add_argument("--root", action="append", help="extra root to search; may be used multiple times")
    p.add_argument("--home", action="store_true", help="scan entire home directory; slower")
    p.add_argument("--all", action="store_true", help="show files above minimum even if metadata cannot be parsed")


def main():
    parser = argparse.ArgumentParser(
        prog="llama.cpp",
        description="Manage llama.cpp serving, cli sessions, and local GGUF files.",
    )

    sub = parser.add_subparsers(dest="command")

    p_serve = sub.add_parser("serve", help="start llama-server in tmux")
    p_serve.add_argument("--replace", action="store_true", help="kill existing llama tmux session first")
    p_serve.add_argument("model", help="HF model repo, optionally with :quant/tag")
    p_serve.add_argument("extra", nargs=argparse.REMAINDER, help="extra llama-server args")
    p_serve.set_defaults(func=cmd_serve)

    p_run = sub.add_parser("run", help="start llama-cli in the foreground")
    p_run.add_argument("model", help="HF model repo, optionally with :quant/tag")
    p_run.add_argument("extra", nargs=argparse.REMAINDER, help="extra llama-cli args")
    p_run.set_defaults(func=cmd_run)

    p_list = sub.add_parser("list", help="list local GGUF models")
    add_list_args(p_list)
    p_list.set_defaults(func=cmd_list)

    p_files = sub.add_parser("files", help="list local GGUF model files and paths")
    add_list_args(p_files)
    p_files.set_defaults(func=cmd_files)

    p_status = sub.add_parser("status", help="show llama-server tmux session status")
    p_status.set_defaults(func=cmd_status)

    p_attach = sub.add_parser("attach", help="attach to llama-server tmux session")
    p_attach.set_defaults(func=cmd_attach)

    p_stop = sub.add_parser("stop", help="stop llama-server tmux session")
    p_stop.set_defaults(func=cmd_stop)

    p_logs = sub.add_parser("logs", help="tail llama-server log")
    p_logs.add_argument("-n", "--lines", type=int, default=80, help="lines to show before following")
    p_logs.set_defaults(func=cmd_logs)

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        return 1

    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())

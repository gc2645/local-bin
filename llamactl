LOG_DIR = os.path.expanduser("~/.cache/llama")
LOG_FILE = os.path.join(LOG_DIR, "llama-server.log")


def profile_args_for(model):
    args = []

    for needle, extra in MODEL_PROFILES.items():
        if needle in model:
            args.extend(extra)

    return args


def require_binary(binary):
    if shutil.which(binary) is None:
        print(f"ERROR: binary not found: {binary}", file=sys.stderr)
        sys.exit(1)


def require_tmux():
    require_binary(TMUX)


def tmux_has_session(session):
    result = subprocess.run(
        [TMUX, "has-session", "-t", session],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return result.returncode == 0


def build_server_command(model, extra_args):
    return [
        LLAMA_SERVER,
        "-hf", model,
        *DEFAULT_SERVER_ARGS,
        *profile_args_for(model),
        *extra_args,
    ]


def build_cli_command(model, extra_args):
    return [
        LLAMA_CLI,
        "-hf", model,
        *DEFAULT_CLI_ARGS,
        *profile_args_for(model),
        *extra_args,
    ]


def cmd_serve(args):
    require_tmux()
    require_binary(LLAMA_SERVER)
    os.makedirs(LOG_DIR, exist_ok=True)

    if tmux_has_session(SESSION):
        if not args.replace:
            print(f"llama-server tmux session already exists: {SESSION}")
            print()
            print("Use one of these:")
            print("  llamactl attach")
            print("  llamactl stop")
            print(f"  llamactl serve --replace {args.model}")
            return 1

        subprocess.run([TMUX, "kill-session", "-t", SESSION], check=False)

    cmd = build_server_command(args.model, args.extra)

    quoted = " ".join(shlex.quote(x) for x in cmd)
    shell_cmd = (
        "set -o pipefail; "
        f"echo '### {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}'; "
        f"echo {shlex.quote(quoted)}; "
        f"exec {quoted} 2>&1 | tee -a {shlex.quote(LOG_FILE)}"
    )

    subprocess.run(
        [TMUX, "new-session", "-s", SESSION, "bash", "-lc", shell_cmd],
        check=True,
    )

    print(f"Started llama-server in tmux session: {SESSION}")
    print()
    print("Command:")
    print(f"  {quoted}")
    print()
    print("Useful:")
    print("  llamactl attach")
    print("  llamactl logs")
    print("  llamactl stop")

    return 0


def cmd_run(args):
    require_binary(LLAMA_CLI)

    cmd = build_cli_command(args.model, args.extra)
    quoted = " ".join(shlex.quote(x) for x in cmd)

    print("Starting llama-cli:")
    print(f"  {quoted}")
    print()

    os.execvp(cmd[0], cmd)


def cmd_stop(_args):
    require_tmux()

    if not tmux_has_session(SESSION):
        print(f"No tmux session named {SESSION}")
        return 0

    subprocess.run([TMUX, "kill-session", "-t", SESSION], check=True)
    print(f"Stopped tmux session: {SESSION}")
    return 0


def cmd_attach(_args):
    require_tmux()

    if not tmux_has_session(SESSION):
        print(f"No tmux session named {SESSION}")
        return 1

    os.execvp(TMUX, [TMUX, "attach", "-t", SESSION])


def cmd_status(_args):
    require_tmux()

    if tmux_has_session(SESSION):
        print(f"llama-server tmux session is running: {SESSION}")
        subprocess.run([TMUX, "list-sessions"], check=False)
        return 0

    print(f"llama-server tmux session is not running: {SESSION}")
    return 1


def cmd_logs(args):
    if not os.path.exists(LOG_FILE):
        print(f"No log file found: {LOG_FILE}")
        return 1

    lines = str(args.lines)
    os.execvp("tail", ["tail", "-n", lines, "-f", LOG_FILE])



QUANT_RE = re.compile(
    r"(?:^|[-_.])("
    r"UD-Q[2-8]_[0-9A-Z_]+|"
    r"UD-IQ[1-4]_[0-9A-Z_]+|"
    r"MXFP4|"
    r"Q[2-8]_[0-9A-Z_]+|"
    r"IQ[1-4]_[0-9A-Z_]+|"
    r"BF16|F16|F32|"
    r"TQ[12]_0"
    r")(?:[-_.]|$)",
    re.IGNORECASE,
)

SHARD_RE = re.compile(
    r"^(?P<prefix>.+)-(?P<num>\d{5})-of-(?P<total>\d{5})\.gguf$",
    re.IGNORECASE,
)


def human_size(num):
    num = float(num)

    for unit in ["B", "KB", "MB", "GB", "TB"]:
        if num < 1024.0 or unit == "TB":
            if unit == "B":
                return f"{num:.0f}B"
            return f"{num:.1f}{unit}"
        num /= 1024.0


def read_u32(f):
    return struct.unpack("<I", f.read(4))[0]


def read_u64(f):
    return struct.unpack("<Q", f.read(8))[0]


def read_i32(f):
    return struct.unpack("<i", f.read(4))[0]


def read_i64(f):
    return struct.unpack("<q", f.read(8))[0]


def read_f32(f):
    return struct.unpack("<f", f.read(4))[0]


def read_f64(f):
    return struct.unpack("<d", f.read(8))[0]


def read_string(f):
    n = read_u64(f)
    data = f.read(n)
    return data.decode("utf-8", errors="replace")


def skip_value(f, t):
    if t in (0, 1, 7):
        f.seek(1, os.SEEK_CUR)
    elif t in (2, 3):
        f.seek(2, os.SEEK_CUR)
    elif t in (4, 5, 6):
        f.seek(4, os.SEEK_CUR)
    elif t in (10, 11, 12):
        f.seek(8, os.SEEK_CUR)
    elif t == 8:
        n = read_u64(f)
        f.seek(n, os.SEEK_CUR)
    elif t == 9:
        elem_type = read_u32(f)
        count = read_u64(f)

        for _ in range(count):
            skip_value(f, elem_type)
    else:
        raise ValueError(f"unknown GGUF metadata type {t}")


def read_value(f, t):
    if t == 0:
        return struct.unpack("<B", f.read(1))[0]
    if t == 1:
        return struct.unpack("<b", f.read(1))[0]
    if t == 2:
        return struct.unpack("<H", f.read(2))[0]
    if t == 3:
        return struct.unpack("<h", f.read(2))[0]
    if t == 4:
        return read_u32(f)
    if t == 5:
        return read_i32(f)
    if t == 6:
        return read_f32(f)
    if t == 7:
        return bool(struct.unpack("<?", f.read(1))[0])
    if t == 8:
        return read_string(f)
    if t == 10:
        return read_u64(f)
    if t == 11:
        return read_i64(f)
    if t == 12:
        return read_f64(f)
    if t == 9:
        elem_type = read_u32(f)
        count = read_u64(f)

        for _ in range(count):
            skip_value(f, elem_type)

        return f"array:{count}"

    raise ValueError(f"unknown GGUF metadata type {t}")


def parse_gguf(path):
    meta = {}

    try:
        with open(path, "rb") as f:
            if f.read(4) != b"GGUF":
                return meta

            meta["_gguf_version"] = read_u32(f)
            meta["_tensor_count"] = read_u64(f)
            meta["_kv_count"] = read_u64(f)

            for _ in range(meta["_kv_count"]):
                key = read_string(f)
                val_type = read_u32(f)
                meta[key] = read_value(f, val_type)

    except Exception as e:
        meta["_error"] = str(e)

    return meta


def repo_from_path(path):
    parts = path.split(os.sep)

    for p in parts:
        if p.startswith("models--"):
            return p.replace("models--", "").replace("--", "/")

    return ""


def compact_path(path):
    home = os.path.expanduser("~")

    if path.startswith(home):
        return "~" + path[len(home):]

    return path


def first_meta(meta, keys, default="?"):
    for key in keys:
        val = meta.get(key)

        if val not in (None, ""):
            return val

    return default


def quant_from_filename(path, meta):
    name = os.path.basename(path)

    matches = QUANT_RE.findall(name)
    if matches:
        return matches[-1].upper()

    ft = meta.get("general.file_type")

    if isinstance(ft, int) and ft in FILE_TYPE_MAP:
        return FILE_TYPE_MAP[ft]

    return "?"


def clean_model_name(path):
    repo = repo_from_path(path)

    if repo:
        return repo

    base = os.path.basename(path)

    shard = SHARD_RE.match(base)
    if shard:
        base = shard.group("prefix") + ".gguf"

    return re.sub(r"\.gguf$", "", base, flags=re.IGNORECASE)


def clean_file_name(path):
    return os.path.basename(path)


def model_with_quant(path, meta):
    model = clean_model_name(path)
    quant = quant_from_filename(path, meta)

    if quant == "?":
        return model

    if model.endswith(f":{quant}"):
        return model

    return f"{model}:{quant}"


def row_quality(row):
    score = 0

    for key in ["ctx", "layers", "embed"]:
        if row.get(key) not in (None, "", "?"):
            score += 1

    if row.get("has_error"):
        score -= 10

    return score


def find_ggufs(roots, min_bytes):
    seen = set()

    for root in roots:
        root = os.path.expanduser(root)

        if not os.path.exists(root):
            continue

        if os.path.isfile(root):
            candidates = [root]
        else:
            candidates = []

            for dirpath, dirnames, filenames in os.walk(root):
                rel = os.path.relpath(dirpath, os.path.expanduser("~"))

                dirnames[:] = [
                    d for d in dirnames
                    if d not in SKIP_DIRS and os.path.join(rel, d) not in SKIP_DIRS
                ]

                for filename in filenames:
                    if filename.lower().endswith(".gguf"):
                        candidates.append(os.path.join(dirpath, filename))

        for path in candidates:
            try:
                real = os.path.realpath(path)

                if real in seen:
                    continue

                seen.add(real)

                st = os.stat(path)

                if st.st_size < min_bytes:
                    continue

                yield path, st

            except OSError:
                continue


def shorten(s, width):
    s = str(s)

    if len(s) <= width:
        return s

    if width <= 1:
        return "…"

    return s[:width - 1] + "…"


def aggregate_model_rows(rows):
    grouped = {}

    for row in rows:
        key = row["model"]

        if key not in grouped:
            grouped[key] = dict(row)
            grouped[key]["bytes"] = 0
            grouped[key]["file_count"] = 0
            grouped[key]["best_row"] = row

        g = grouped[key]
        g["bytes"] += row["bytes"]
        g["file_count"] += 1

        if row_quality(row) > row_quality(g["best_row"]):
            g["best_row"] = row

        if row["mtime"] > g["mtime"]:
            g["mtime"] = row["mtime"]

    out = []

    for key, g in grouped.items():
        best = g["best_row"]

        final = dict(best)
        final["bytes"] = g["bytes"]
        final["size"] = human_size(g["bytes"])
        final["mtime"] = g["mtime"]
        final["modified"] = datetime.fromtimestamp(g["mtime"]).strftime("%Y-%m-%d %H:%M")
        final["file_count"] = g["file_count"]

        out.append(final)

    out.sort(key=lambda r: r["model"].lower())
    return out


def print_table(rows, show_files=False):
    if not rows:
        print("No GGUF LLM files found above the minimum size.")
        return

    term_width = shutil.get_terminal_size((150, 24)).columns
    term_width = max(term_width, 90)

    if not show_files:
        headers = [
            "MODEL",
            "SIZE",
            "CTX",
            "LAYERS",
            "EMBED",
            "MODIFIED",
        ]

        widths = {
            "SIZE": 7,
            "CTX": 7,
            "LAYERS": 6,
            "EMBED": 6,
            "MODIFIED": 16,
        }

        fixed_width = (
            2 +
            widths["SIZE"] + 2 +
            widths["CTX"] + 2 +
            widths["LAYERS"] + 2 +
            widths["EMBED"] + 2 +
            widths["MODIFIED"]
        )

        max_model_len = max(len("MODEL"), *(len(r["model"]) for r in rows))
        model_width = min(max_model_len, max(24, term_width - fixed_width))

        fmt = (
            f"{{:<{model_width}}}  "
            f"{{:<{widths['SIZE']}}}  "
            f"{{:>{widths['CTX']}}}  "
            f"{{:>{widths['LAYERS']}}}  "
            f"{{:>{widths['EMBED']}}}  "
            f"{{:<{widths['MODIFIED']}}}"
        )

        print()
        print("Local llama.cpp GGUF models")
        print("=" * min(term_width, 140))
        print(fmt.format(*headers))
        print(fmt.format(
            "-----",
            "----",
            "---",
            "------",
            "-----",
            "--------",
        ))

        for r in rows:
            print(fmt.format(
                shorten(r["model"], model_width),
                r["size"],
                r["ctx"],
                r["layers"],
                r["embed"],
                r["modified"],
            ))

        return

    print()
    print("Model files")
    print("-" * min(term_width, 140))

    for r in rows:
        print(f"{r['size']:>8}  {r['model']}")
        print(f"          file: {r['file']}")
        print(f"          path: {compact_path(r['path'])}")


def get_file_rows(args):
    roots = list(DEFAULT_ROOTS)

    if args.root:
        roots.extend(args.root)

    if args.home:
        roots.append("~")

    min_bytes = int(args.min_gb * 1024 ** 3)
    rows = []

    for path, st in find_ggufs(roots, min_bytes):
        meta = parse_gguf(path)

        if "_error" in meta and not args.all:
            continue

        arch = str(first_meta(meta, ["general.architecture"], "?"))

        ctx_key = f"{arch}.context_length" if arch != "?" else ""
        layers_key = f"{arch}.block_count" if arch != "?" else ""
        embed_key = f"{arch}.embedding_length" if arch != "?" else ""

        ctx = first_meta(meta, [ctx_key, "llama.context_length"], "?")
        layers = first_meta(meta, [layers_key, "llama.block_count"], "?")
        embed = first_meta(meta, [embed_key, "llama.embedding_length"], "?")

        rows.append({
            "size": human_size(st.st_size),
            "bytes": st.st_size,
            "ctx": str(ctx),
            "layers": str(layers),
            "embed": str(embed),
            "modified": datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M"),
            "mtime": st.st_mtime,
            "model": model_with_quant(path, meta),
            "file": clean_file_name(path),
            "path": path,
            "has_error": "_error" in meta,
        })

    rows.sort(key=lambda r: (r["model"].lower(), r["file"].lower()))
    return rows


def cmd_list(args):
    file_rows = get_file_rows(args)
    rows = aggregate_model_rows(file_rows)
    print_table(rows, show_files=False)
    return 0


def cmd_files(args):
    rows = get_file_rows(args)
    print_table(rows, show_files=True)
    return 0


